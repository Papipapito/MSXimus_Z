# top_zynq_tr.xdc - perfil TR (fase 2): el R800 (nucleo + bus + regulador de tiempo) avanza solo con el habilitador de 21,477 MHz (35/88 de 54 MHz):
# entre dos habilitadores hay al menos 2 ciclos de clk_54m, asi que los caminos ENTRE sus registros tienen 2 ciclos. Solo dentro del R800 (u_b = r800_bus
# con el nucleo, u_t = r800_timing): la logica de tr_cpu que corre cada ciclo (parada, cambio de CPU) y los cruces con el resto siguen a un ciclo.
set tr_cells [get_cells -hierarchical -filter {NAME =~ u_trcpu/u_b/* || NAME =~ u_trcpu/u_t/*}]
set_multicycle_path 2 -setup -from $tr_cells -to $tr_cells
set_multicycle_path 1 -hold  -from $tr_cells -to $tr_cells
# Telemetria de depuracion de tr_cpu (solo se lee por JTAG): sin restriccion de tiempo desde el R800 (los registros de arriba solo cambian con ce21)
set tr_tel [get_cells -hierarchical -filter {NAME =~ u_trcpu/flags_q_reg* || NAME =~ u_trcpu/a_live_reg* || NAME =~ u_trcpu/pc_r_reg* || NAME =~ u_trcpu/pc_z_reg* || NAME =~ u_trcpu/io_a_reg* || NAME =~ u_trcpu/io_d_reg* || NAME =~ u_trcpu/io_wr_reg* || NAME =~ u_trcpu/d_m1_reg* || NAME =~ u_trcpu/last_pc_reg* || NAME =~ u_trcpu/ring_reg* || NAME =~ u_trcpu/w*_reg* || NAME =~ u_trcpu/mw*_reg* || NAME =~ u_trcpu/tmem_reg* || NAME =~ u_trcpu/t?_q_reg* || NAME =~ u_trcpu/tseq_reg* || NAME =~ u_trcpu/tarm_reg* || NAME =~ u_trcpu/nopc_reg* || NAME =~ u_trcpu/tarm2_reg* || NAME =~ u_trcpu/tarm3_reg* || NAME =~ u_trcpu/iow_q_reg* || NAME =~ u_trcpu/tcnt3_reg* || NAME =~ u_trcpu/last98_reg* || NAME =~ u_trcpu/tcnt2_reg* || NAME =~ u_trcpu/tfrz_reg* || NAME =~ u_trcpu/tcnt_reg* || NAME =~ u_trcpu/frq_q_reg* || NAME =~ u_trcpu/twp_reg* || NAME =~ u_trcpu/k_q_reg* || NAME =~ u_trcpu/cpu_qq_reg* || NAME =~ u_trcpu/rd_*_reg* || NAME =~ u_trcpu/r_pc_reg* || NAME =~ u_trcpu/postc_reg* || NAME =~ u_trcpu/rtgt_reg* || NAME =~ u_trcpu/o?_reg* || NAME =~ u_trcpu/rwp_reg* || NAME =~ u_trcpu/rfrz_reg* || NAME =~ u_trcpu/trig_why_reg* || NAME =~ u_trcpu/sp_*_reg* || NAME =~ u_trcpu/cnt_*_reg* || NAME =~ u_trcpu/sw_cnt_reg*}]
set_false_path -from $tr_cells -to $tr_tel
