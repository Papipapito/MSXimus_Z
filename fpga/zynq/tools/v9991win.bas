10 ' V9991WIN.BAS - la ventana del V9968 dentro del V9990 (MSXimus Z, 28/10/2026)
20 ' El V9990 en B1 4 bpp hace de escritorio: fondo azul, un marco naranja y un
30 ' area cliente rellena del color 0, que es TRANSPARENTE (bit YS de paleta, YSE
40 ' en R#8): por ahi se ve el V9968 (esta misma pantalla de BASIC) a tamano x1.
50 ' Los registros R#55-R#62 son del MSXimus Z (un V9990 real los ignora).
60 ' Al encender la pantalla del V9990 la HDMI pasa sola al V9990 (automatico).
70 ' Para salir: OUT &H64,8:OUT &H63,0 (apaga la pantalla) y Pausa, o reset.
100 OUT &H67,0
110 R=8:V=0:GOSUB 1000
120 R=6:V=&H81:GOSUB 1000
130 R=7:V=0:GOSUB 1000
140 R=13:V=0:GOSUB 1000
150 R=14:V=0:GOSUB 1000
160 OUT &H61,&H80:OUT &H61,0:OUT &H61,0
170 OUT &H61,&H1F:OUT &H61,&H10:OUT &H61,0
180 OUT &H61,&H08:OUT &H61,&H08:OUT &H61,&H1F
190 R=15:V=2:GOSUB 1000
200 X=0:Y=0:W=256:H=212:C=&H22:GOSUB 2000
210 X=20:Y=20:W=216:H=172:C=&H11:GOSUB 2000
220 X=24:Y=24:W=208:H=164:C=0:GOSUB 2000
230 R=56:V=24:GOSUB 1000:R=57:V=0:GOSUB 1000
240 R=58:V=24:GOSUB 1000:R=59:V=0:GOSUB 1000
250 R=60:V=0:GOSUB 1000:R=61:V=0:GOSUB 1000:R=62:V=0:GOSUB 1000
260 R=55:V=&HA0:GOSUB 1000
270 R=8:V=&HE0:GOSUB 1000
280 PRINT "V9991: ventana en (24,24), x1. Teclas: cursores mueven, X escala, ESC apaga"
290 WX=24:WY=24:SC=0
300 K$=INKEY$:IF K$="" THEN 300
310 IF K$=CHR$(27) THEN R=8:V=0:GOSUB 1000:END
320 IF K$=CHR$(28) THEN WX=WX+4
330 IF K$=CHR$(29) THEN WX=WX-4
340 IF K$=CHR$(30) THEN WY=WY-4
350 IF K$=CHR$(31) THEN WY=WY+4
360 IF K$="x" OR K$="X" THEN SC=1-SC
370 R=56:V=WX AND 255:GOSUB 1000:R=57:V=(WX\256) AND 7:GOSUB 1000
380 R=58:V=WY AND 255:GOSUB 1000:R=59:V=(WY\256) AND 7:GOSUB 1000
390 R=55:V=&HA0 OR (SC*8):GOSUB 1000
400 GOTO 300
1000 OUT &H64,R:OUT &H63,V:RETURN
2000 ' LMMV: rellena (X,Y) de W x H pixeles con el byte C (dos pixeles de 4 bits)
2010 R=36:V=X AND 255:GOSUB 1000:R=37:V=X\256:GOSUB 1000
2020 R=38:V=Y AND 255:GOSUB 1000:R=39:V=Y\256:GOSUB 1000
2030 R=40:V=W AND 255:GOSUB 1000:R=41:V=W\256:GOSUB 1000
2040 R=42:V=H AND 255:GOSUB 1000:R=43:V=H\256:GOSUB 1000
2050 R=45:V=&H0C:GOSUB 1000
2060 R=46:V=255:GOSUB 1000:R=47:V=255:GOSUB 1000
2070 R=48:V=C:GOSUB 1000:R=49:V=C:GOSUB 1000
2080 R=52:V=&H20:GOSUB 1000
2090 IF (INP(&H65) AND 1) THEN 2090
2100 RETURN
