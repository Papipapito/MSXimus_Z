10 ' V9991B7.BAS - la ventana del V9968 en un escritorio B7 del V9990 (MSXimus Z, 28/10/2026)
20 ' El V9990 en B7 (1024 x 212 a 4 bpp; con IL=1 en la linea 95, 1024 x 424
30 ' entrelazado) hace de escritorio: fondo azul, un marco naranja y un hueco
40 ' de 512 x 106 relleno del color 5, que es TRANSPARENTE (bit YS de paleta,
50 ' YSE en R#8): por ahi se ve el V9968 (esta pantalla) ENTERO a x0,5 (512 x
60 ' 318 px = 106 lineas de B7). A x1 mediria 1024 puntos, todo el ancho.
70 ' Teclas: cursores mueven la ventana, X cambia la escala, ESC apaga el V9990.
80 ' Para volver al V9968: Pausa (o ESC y Pausa), o reset.
95 IL=0:H=212:IF IL THEN H=424
100 OUT &H67,0
110 R=8:V=0:GOSUB 1000
120 R=6:V=&HA9:GOSUB 1000
130 R=7:V=0:IF IL THEN V=6
135 GOSUB 1000
140 R=13:V=0:GOSUB 1000
150 R=14:V=0:GOSUB 1000
160 OUT &H61,&H80:OUT &H61,0:OUT &H61,0
170 OUT &H61,&H1F:OUT &H61,&H10:OUT &H61,0
180 OUT &H61,&H08:OUT &H61,&H08:OUT &H61,&H1F
182 OUT &H61,&H1F:OUT &H61,&H1F:OUT &H61,&H1F
184 OUT &H61,&H08:OUT &H61,&H08:OUT &H61,&H08
186 OUT &H61,&H80:OUT &H61,0:OUT &H61,0
190 R=15:V=2:GOSUB 1000
200 X=0:Y=0:W=1024:H1=H:C=&H22:GOSUB 2000
210 X=8:Y=16:W=232:H1=48*(1+IL):C=&H11:GOSUB 2000
220 X=10:Y=18:W=228:H1=44*(1+IL):C=&H44:GOSUB 2000
225 X=254:Y=51*(1+IL):W=516:H1=110*(1+IL):C=&H11:GOSUB 2000
228 X=256:Y=53*(1+IL):W=512:H1=106*(1+IL):C=&H55:GOSUB 2000
230 WX=256:WY=53*(1+IL):SC=1
240 R=56:V=WX AND 255:GOSUB 1000:R=57:V=WX\256:GOSUB 1000
250 R=58:V=WY AND 255:GOSUB 1000:R=59:V=WY\256:GOSUB 1000
255 R=60:V=0:GOSUB 1000:R=61:V=0:GOSUB 1000:R=62:V=0:GOSUB 1000
260 R=55:V=&HA4:GOSUB 1000
270 R=8:V=&HE0:GOSUB 1000
280 PRINT "V9991 B7: el MSX a x0.5 en (256,53). Cursores mueven, X escala, ESC apaga"
300 K$=INKEY$:IF K$="" THEN 300
310 IF K$=CHR$(27) THEN R=8:V=0:GOSUB 1000:END
320 IF K$=CHR$(28) THEN WX=WX+8
330 IF K$=CHR$(29) THEN WX=WX-8
340 IF K$=CHR$(30) THEN WY=WY-4
350 IF K$=CHR$(31) THEN WY=WY+4
360 IF K$="x" OR K$="X" THEN SC=(SC+1) MOD 3
370 R=56:V=WX AND 255:GOSUB 1000:R=57:V=(WX\256) AND 7:GOSUB 1000
380 R=58:V=WY AND 255:GOSUB 1000:R=59:V=(WY\256) AND 7:GOSUB 1000
390 R=55:V=&HA0 OR (SC*4):GOSUB 1000
400 GOTO 300
1000 OUT &H64,R:OUT &H63,V:RETURN
2000 ' LMMV: rellena (X,Y) de W x H1 pixeles con el byte C (dos pixeles de 4 bits)
2010 R=36:V=X AND 255:GOSUB 1000:R=37:V=X\256:GOSUB 1000
2020 R=38:V=Y AND 255:GOSUB 1000:R=39:V=Y\256:GOSUB 1000
2030 R=40:V=W AND 255:GOSUB 1000:R=41:V=W\256:GOSUB 1000
2040 R=42:V=H1 AND 255:GOSUB 1000:R=43:V=H1\256:GOSUB 1000
2050 R=45:V=&H0C:GOSUB 1000
2060 R=46:V=255:GOSUB 1000:R=47:V=255:GOSUB 1000
2070 R=48:V=C:GOSUB 1000:R=49:V=C:GOSUB 1000
2080 R=52:V=&H20:GOSUB 1000
2090 IF (INP(&H65) AND 1) THEN 2090
2100 RETURN
