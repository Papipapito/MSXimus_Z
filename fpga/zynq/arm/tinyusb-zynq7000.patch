+//--------------------------------------------------------------------+
+// Application watchdog support
+//--------------------------------------------------------------------+
+
+// MSXimus (01/11/2026): signature of the progress of the periodic split transactions (full/low speed
+// endpoints behind a high speed hub). For every periodic QH in use with FS/LS speed and an active overlay,
+// the HC rewrites FrameTag (overlay buffer[2] bits 4:0), C-prog-mask (buffer[1] bits 7:0) and SplitX (token
+// bit 1) on every start/complete split. If the periodic engine hangs they freeze, so a signature that does
+// not change for seconds while FRINDEX runs means a hung EHCI. *n_active = number of QHs hashed (0 = nothing
+// to judge: no split endpoint is polling). The caller (application) owns the policy.
+uint32_t ehci_split_signature(uint32_t* n_active) {
+  uint32_t sig = 2166136261u; // FNV-1a
+  uint32_t n = 0;
+
+  for (uint32_t i = 0; i < QHD_MAX; i++) {
+    ehci_qhd_t* qhd = &ehci_data.qhd_pool[i];
+    if (!qhd->used || qhd->removing || !qhd_is_periodic(qhd) || qhd->ep_speed == TUSB_SPEED_HIGH) {
+      continue;
+    }
+    hcd_dcache_invalidate(qhd, sizeof(ehci_qhd_t));
+    if (!qhd->qtd_overlay.active) {
+      continue;
+    }
+    uint32_t const v = (qhd->qtd_overlay.buffer[2] & 0x1Fu) | ((qhd->qtd_overlay.buffer[1] & 0xFFu) << 5) |
+                       ((uint32_t) qhd->qtd_overlay.non_hs_split_state << 13) | (i << 16);
+    sig = (sig ^ v) * 16777619u;
+    n++;
   }
+
+  *n_active = n;
+  return sig;
 }
 
