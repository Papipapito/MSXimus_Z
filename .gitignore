# --- Gowin GW5A synthesis / place-and-route outputs ---
fpga/impl/
fpga/**/impl/
fpga/build_log.txt
fpga/*.log
fpga/**/*.log
*.gprj.user
# Temporales del IP Core Generator (regenerables, basura)
**/*_tmp.v

# --- Copyrighted MSX BIOS pack — NOT redistributed ---
# Se construye localmente desde tus propias ROMs y se flashea (dirección re-mapeada en el 60K).
fpga/src/rom/*.bin
fpga/src/rom/*.fs
fpga/src/rom/*.ROM

# --- Entregas de bitstream (packs con copyright) ---
# files/<fecha>/ = entregas (BOOT.bin y packs con ROMs, bitstreams repetidos): solo se versionan sus LEEME
files/**
!files/*/
!files/*/LEEME*.txt

# --- Bases de datos de herramientas (regenerables, no son del proyecto) ---
ruvector.db
**/ruvector.db

# --- Office / editor temporales ---
~$*
*.swp
.DS_Store

# --- Ficheros basura sueltos ---
/0
/D

# Artefactos de simulacion (regenerables)
*.vvp
*.vcd
*.bak
*.raw
tools/**/.build*/
tools/v9968_sim/logs/
tools/v9968_sim/deltas.log
tools/v9968_sim/*_run*.log
tools/v9968_sim/s8full_frame.txt
tools/v9968_sim/*.png
tools/opl3_sim/obj_timer/
# Volcados de analisis de la caza del OPL4 (regenerables) y ROMs Yamaha (copyright)
tools/opl4wave_sim/*.txt
tools/opl4wave_sim/*.hex
tools/opl4wave_sim/probe*.v

# Estimacion de sintesis OPL4 para el TN20K (estudio aparte, no es del MSXimus)
fpga/opl4_20k_est/

# --- Entregas listas para flashear (no se suben) ---
# mi_release/<version>/ = lo publicable de cada version oficial (Z1: dentro del repo); 3.1 era del Tang
mi_release/*
!mi_release/z1.0/

# --- Volcados de simulacion del V9968 (regenerables, 5 MB cada uno) ---
# Se retiraron 14 (~66 MB) el 08/08: los s5..s8_frame.txt eran del 21/07 y ya
# estaban OBSOLETOS (geometria del frame cambiada; el propio
# run_screen678_th.sh explica que no se comparan contra ellos). El metodo
# valido es comparar shim-referencia vs shim-trabajo con el MISMO core.
# EXCEPCION: s3r_frame.txt se conserva — es la REFERENCIA DORADA que lee
# run_sprite3_iv.sh (regenerable con './run_sprite3_iv.sh ref').
tools/v9968_sim/s*_frame*.txt
!tools/v9968_sim/s3r_frame.txt
tools/v9968_sim/s8_glitch.txt
tools/v9968_sim/*.raw
tools/v9968_sim/*.ppm

# Salidas de los bancos de la SD (regenerables con tools/sd_tb/run.sh)
tools/sd_tb/log_*.txt

# --- bases de datos locales de herramientas de desarrollo, no son del proyecto ---
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# V9990: proyecto OOC de prueba de humo y consolas de build (tools/synth_v9990_ooc.tcl, build.tcl)
fpga/zynq/v9990_ooc/
fpga/zynq/build_*.txt

# Lo que lleva ROMs o ficheros con copyright no se publica (packs/zynq/, assets/):
# los packs de BIOS, la FM-BIOS base del menu y la ROM de ondas YRW801. El contenido de la SD esta en SD_Maker.
bios/packs/*/
bios/assets/16k_*.bin
fpga/zynq/arm/boot/yrw801.rom
fpga/zynq/arm/boot/pack.bin
*.rom
*.ROM
!bios/nextor214/*.ROM
!bios/nextor3/*.ROM
!tools/*/*.rom
!fpga/src/rom/*.rom

# restos de las builds y de los bancos del perfil TR
fpga/zynq/*.err
fpga/zynq/cdc_tr*
fpga/r800/sim/*.bin
